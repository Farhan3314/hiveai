rules_version = '2';

// -----------------------------------------------------------------------
// HiveAI Firestore rules
// -----------------------------------------------------------------------
// This app has no backend — every read/write in src/services/*.js comes
// straight from the client, so these rules ARE the app's only real access
// control. They're written to match the exact access patterns the code in
// src/services already assumes (see the comments in groups.js in
// particular, which describe several of these decisions).
// -----------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds.hasAny([request.auth.uid]);
    }

    function isGroupCreator(groupId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // users/{uid} — profile (name, email, emailLower, photoURL, plan,
    // aiTokensUsed, aiUsageMonth)
    // ---------------------------------------------------------------
    match /users/{uid} {
      // findUserByEmail (services/users.js) queries across ALL users by
      // emailLower/email to support friend requests — every signed-in
      // user needs read access to every profile doc for that to work.
      allow read: if isSignedIn();
      // Every write in the app (ensureUserProfile, updateUserDoc,
      // incrementAIUsage, checkAIUsageLimit's monthly reset) only ever
      // targets the caller's own doc.
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;

      // Personal AI Assistant conversations — private to the owner.
      match /aiChats/{chatId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;

        match /messages/{messageId} {
          allow read, write: if isSignedIn() && request.auth.uid == uid;
        }

        // BUGFIX: document/file uploads in the AI Assistant go through the
        // same RAG pipeline as group chat (services/rag.js: ingestDocument →
        // users/{uid}/aiChats/{chatId}/ragDocuments/{docId}/chunks/{chunkId}),
        // but this scope had no rule for it. Firestore rules don't cascade to
        // subcollections, so every write here was silently denied
        // ("Missing or insufficient permissions"), which is exactly why
        // FileAnalysisScreen always ended up in its error state for any file
        // attached from the AI Assistant (group chat's equivalent
        // groups/{groupId}/ragDocuments rule below already covered that
        // case, which is why only the AI Assistant looked broken).
        match /ragDocuments/{docId} {
          allow read, create, update: if isSignedIn() && request.auth.uid == uid;
          allow delete: if isSignedIn() && request.auth.uid == uid;

          match /chunks/{chunkId} {
            allow read, create: if isSignedIn() && request.auth.uid == uid;
            allow update: if false;
            allow delete: if isSignedIn() && request.auth.uid == uid;
          }
        }
      }
    }

    // ---------------------------------------------------------------
    // groups/{groupId}
    // ---------------------------------------------------------------
    match /groups/{groupId} {
      // Single-doc reads (getGroup, subscribeGroup, and the join-by-code
      // flow's post-preview lookup) are open to any signed-in user — a
      // group's Firestore ID isn't guessable/discoverable on its own,
      // which is the same trust boundary groupInvites already relies on
      // (see the comment there). LISTING the collection is still locked
      // to actual members via the query itself, since a `list` request is
      // evaluated per-candidate-document against `resource.data` below.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.memberIds.hasAny([request.auth.uid]);

      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.memberIds.hasAny([request.auth.uid]);

      // A current member can update the group (rename, leave, kick
      // someone, set an invite code, bump membersCount, ...). Someone who
      // is NOT yet a member can only update it to add themselves —
      // covers addMemberToGroup for a first-time joiner (accepted invite
      // or invite-link code), who by definition isn't in memberIds yet.
      allow update: if isSignedIn() && (
        resource.data.memberIds.hasAny([request.auth.uid]) ||
        request.resource.data.memberIds.hasAny([request.auth.uid])
      );

      // Only the creator can delete a group (matches the client-side
      // `canDelete`/`isAdmin` gating in HomeScreen/MembersScreen).
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        // senderId must be either the caller themselves, or 'hiveai' —
        // AI replies are written directly by whichever member's client
        // triggered them (see services/messages.js), there's no backend
        // bot account to authenticate as.
        allow create: if isGroupMember(groupId) &&
          (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == 'hiveai');
        allow update: if false; // group messages are never edited in place
        // BUGFIX (see services/groups.js:deleteGroup): only allowing the
        // transient 'ai_typing' placeholder to be deleted meant tearing
        // down a group with any real message in it always failed
        // part-way through. The creator can delete ANY message as part
        // of that teardown; any member can still clear a stuck typing
        // placeholder on its own.
        allow delete: if isGroupMember(groupId) &&
          (resource.data.type == 'ai_typing' || isGroupCreator(groupId));
      }

      match /ragDocuments/{docId} {
        allow read, create, update: if isGroupMember(groupId);
        allow delete: if isGroupMember(groupId);

        match /chunks/{chunkId} {
          allow read, create: if isGroupMember(groupId);
          allow update: if false;
          allow delete: if isGroupMember(groupId);
        }
      }
    }

    // ---------------------------------------------------------------
    // groupInvites/{code} — top-level so looking a code up is a single
    // get(), not a query over the whole groups collection (see the long
    // comment above getOrCreateGroupInviteCode in services/groups.js).
    // ---------------------------------------------------------------
    match /groupInvites/{code} {
      // Anyone signed in can look up (and thereby preview/join via) a
      // code they were given — this is the intended "share a link"
      // trust model, same as groups' `get` above.
      allow get: if isSignedIn();
      allow list: if false;
      // Any member of the target group can mint/refresh its invite code
      // (MembersScreen's "Share" is available to every member, not just
      // the admin).
      allow create, update: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        isGroupMember(request.resource.data.groupId);
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // friendRequests/{id}
    // ---------------------------------------------------------------
    match /friendRequests/{id} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid;
      // Only the recipient accepts/declines; syncFriendRequestNotifications
      // also runs off of a request the recipient controls the outcome of.
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid;
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // friendships/{id}
    // ---------------------------------------------------------------
    match /friendships/{id} {
      allow read: if isSignedIn() && resource.data.members.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && request.resource.data.members.hasAny([request.auth.uid]);
      allow update, delete: if false; // no "unfriend" flow exists yet
    }

    // ---------------------------------------------------------------
    // notifications/{id}
    // ---------------------------------------------------------------
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Notifications are created FOR someone else (friend request,
      // group invite, member joined/removed/left) by the acting user's
      // own client — there's no backend to author them instead. Bound
      // what we can: the doc must at least be honest about who's sending
      // it whenever it claims an inviter.
      allow create: if isSignedIn() &&
        request.resource.data.userId is string &&
        (!('inviterUid' in request.resource.data) || request.resource.data.inviterUid == request.auth.uid);
      // The recipient marks their own notifications read, or flips
      // status on Accept/Decline.
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // aiUsageLogs/{id} — analytics for AIUsageScreen (services/usageTracking.js)
    // ---------------------------------------------------------------
    match /aiUsageLogs/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
