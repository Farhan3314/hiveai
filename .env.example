# Required: OpenRouter (free :free models). Get a key at https://openrouter.ai/keys
EXPO_PUBLIC_OPENROUTER_API_KEY=your_openrouter_key_here

# Optional but recommended (free, no card): Google Gemini via AI Studio.
# Has its own free quota, so replies keep working when OpenRouter's free
# models are busy. Get a key at https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=
