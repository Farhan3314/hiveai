rules_version = '2';

// Cloud Storage rules for chat/AI-assistant file attachments.
//
// Group membership is enforced by firestore.rules on the message documents
// themselves (only a group member can even learn a groupFiles/{groupId}/...
// path exists, since that path only ever appears inside a message they're
// already allowed to read). Storage rules can't cheaply cross-check Firestore
// group membership here, so this layer's job is the cheap, absolute checks:
// must be signed in, and must stay under the app's own 25MB upload cap
// (matches MAX_UPLOAD_BYTES in src/services/storage.js) so a modified client
// can't bypass the limit shown to the user.
service firebase.storage {
  match /b/{bucket}/o {

    // Group chat attachments: groupFiles/{groupId}/{fileName}
    match /groupFiles/{groupId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024;
    }

    // AI Assistant attachments: aiChatFiles/{userId}/{chatId}/{fileName}
    // Scoped to the owning user only — this is a private 1:1 AI chat.
    match /aiChatFiles/{userId}/{chatId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 25 * 1024 * 1024;
    }

    // Everything else: closed by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
